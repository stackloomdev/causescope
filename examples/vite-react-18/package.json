{
  "name": "@causescope/example-vite-react-18",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "dev:e2e": "vite --host 127.0.0.1 --port 5191 --strictPort",
