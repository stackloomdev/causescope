    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "causescope": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "vite": "^8.1.5"
  }
}
