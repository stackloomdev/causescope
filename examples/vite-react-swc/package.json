{
  "name": "@causescope/example-vite-react-swc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177",
    "dev:e2e": "vite --host 127.0.0.1 --port 5192 --strictPort",
    "build": "tsc --noEmit && vite build",
