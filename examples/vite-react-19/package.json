{
  "name": "@causescope/example-vite-react-19",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:e2e": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "capture:demo": "node --experimental-strip-types scripts/capture-demo.ts",
    "capture:inspector": "node --experimental-strip-types scripts/capture-inspector.ts",
    "export:demo": "node --experimental-strip-types scripts/export-demo.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --config playwright.firefox.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "causescope": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "4.3.3",
    "vite": "^8.1.5"
  }
}
